@model IEnumerable<FollowUp>
<div class="d-flex justify-content-between align-items-center mb-3"><div><h1>Follow-ups</h1><p class="text-muted">Plan calls, meetings and tasks with customers or leads.</p></div><a asp-action="Create" class="btn btn-primary">Schedule follow-up</a></div><div class="card"><div class="table-responsive"><table class="table table-hover mb-0"><thead><tr><th>Subject</th><th>Date</th><th>Type</th><th>Status</th><th>Assigned to</th><th></th></tr></thead><tbody>@foreach(var x in Model){<tr><td>@x.Subject</td><td>@x.FollowUpDate.ToString("d")</td><td>@x.Type</td><td>@x.Status</td><td>@x.AssignedTo</td><td>@if(x.Status=="Planned"){<form asp-action="Complete" asp-route-id="@x.Id" method="post"><button class="btn btn-sm btn-outline-success">Mark complete</button></form>}</td></tr>}</tbody></table></div></div>
