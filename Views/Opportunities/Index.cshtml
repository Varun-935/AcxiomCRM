@model IEnumerable<Opportunity>
<div class="d-flex justify-content-between align-items-center mb-3"><div><h1>Opportunities</h1><p class="text-muted">Manage deal values and pipeline stages.</p></div><a asp-action="Create" class="btn btn-primary">Add opportunity</a></div><div class="card"><div class="table-responsive"><table class="table table-hover mb-0"><thead><tr><th>Opportunity</th><th>Customer ID</th><th>Amount</th><th>Probability</th><th>Weighted value</th><th>Close date</th><th>Stage</th><th>Move stage</th></tr></thead><tbody>@foreach(var x in Model){<tr><td>@x.Name</td><td>@x.CustomerId</td><td>@x.Amount.ToString("C0")</td><td>@x.Probability%</td><td>@x.WeightedPipeline.ToString("C0")</td><td>@x.ExpectedCloseDate.ToString("d")</td><td>@x.Stage</td><td><form asp-action="Stage" asp-route-id="@x.Id" method="post" class="d-flex gap-1"><select name="stage" class="form-select form-select-sm"><option>Qualification</option><option>Proposal</option><option>Negotiation</option><option>Won</option><option>Lost</option></select><button class="btn btn-sm btn-outline-primary">Save</button></form></td></tr>}</tbody></table></div></div>
