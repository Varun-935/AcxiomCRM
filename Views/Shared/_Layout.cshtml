<!DOCTYPE html>
<html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><title>@ViewData["Title"] - AcxiomCRM</title><link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"/><link href="/css/site.css" rel="stylesheet"/></head>
<body><nav class="navbar navbar-expand-lg navbar-dark bg-dark"><div class="container"><a class="navbar-brand fw-bold" asp-controller="Home" asp-action="Index">AcxiomCRM</a><button class="navbar-toggler" data-bs-toggle="collapse" data-bs-target="#nav"><span class="navbar-toggler-icon"></span></button><div class="collapse navbar-collapse" id="nav"><ul class="navbar-nav me-auto"><li class="nav-item"><a class="nav-link" asp-controller="Customers" asp-action="Index">Customers</a></li><li class="nav-item"><a class="nav-link" asp-controller="Leads" asp-action="Index">Leads</a></li><li class="nav-item"><a class="nav-link" asp-controller="Opportunities" asp-action="Index">Opportunities</a></li><li class="nav-item"><a class="nav-link" asp-controller="FollowUps" asp-action="Index">Follow-ups</a></li><li class="nav-item"><a class="nav-link" asp-controller="Audit" asp-action="Index">Audit Log</a></li></ul><partial name="_LoginPartial"/></div></div></nav><main class="container py-4">@if(TempData["Message"]!=null){<div class="alert alert-info">@TempData["Message"]</div>}@RenderBody()</main><footer class="border-top py-3 text-center text-muted">AcxiomCRM · Customer and Sales Management</footer><script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>@await RenderSectionAsync("Scripts",required:false)</body></html>
