@{ViewData["Title"]="Dashboard";}
<div class="hero p-4 p-md-5 mb-4 rounded-4"><div class="d-flex flex-wrap justify-content-between align-items-center gap-3"><div><p class="text-uppercase small fw-bold mb-2">Customer relationship management</p><h1 class="display-6 fw-bold">Sales overview</h1><p class="mb-0">Manage relationships, track opportunities and stay on top of follow-ups.</p></div><a class="btn btn-light btn-lg" asp-controller="Customers" asp-action="Create">+ Add customer</a></div></div>
<div class="row g-3 mb-4">@foreach(var item in new[]{("Customers",ViewBag.Customers,"bi-people"),("Leads",ViewBag.Leads,"bi-person-lines-fill"),("Open opportunities",ViewBag.Opportunities,"bi-graph-up-arrow"),("Planned follow-ups",ViewBag.FollowUps,"bi-calendar-check")}){<div class="col-6 col-xl-3"><div class="card stat-card h-100"><div class="card-body"><div class="text-muted">@item.Item1</div><div class="display-6 fw-semibold">@item.Item2</div></div></div></div>}</div>
<div class="row g-3"><div class="col-lg-7"><div class="card h-100"><div class="card-body"><h5>Sales pipeline</h5><div class="display-5 fw-bold">@(((decimal)ViewBag.Pipeline).ToString("C0",System.Globalization.CultureInfo.GetCultureInfo("en-IN")))</div><p class="text-muted">Weighted pipeline can be calculated using amount × probability.</p><div class="d-flex gap-2 flex-wrap"><a class="btn btn-primary" asp-controller="Leads" asp-action="Create">Add lead</a><a class="btn btn-outline-primary" asp-controller="Opportunities" asp-action="Create">Add opportunity</a><a class="btn btn-outline-secondary" asp-controller="FollowUps" asp-action="Create">Schedule follow-up</a></div></div></div></div><div class="col-lg-5"><div class="card h-100"><div class="card-body"><h5>Opportunity outcomes</h5><div class="d-flex justify-content-between border-bottom py-3"><span>Won opportunities</span><strong>@ViewBag.Won</strong></div><div class="d-flex justify-content-between py-3"><span>Lost opportunities</span><strong>@ViewBag.Lost</strong></div><p class="small text-muted mb-0">Sign in to manage records and see your team's latest activity.</p></div></div></div></div>
